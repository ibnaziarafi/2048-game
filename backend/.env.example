# Local development: when no Supabase pair or DATABASE_URL is configured.
GAME_DB_PATH=data/2048.sqlite3

# Preferred hosted storage: set this complete pair on the backend only.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SECRET_KEY=sb_secret_<server-only-secret>
# The URL must be the HTTPS project origin with no path/query/credentials.
# Modern sb_secret_ keys are sent only in the apikey header. A legacy
# service_role JWT is also accepted during migration and gets a Bearer header.
# This private key bypasses RLS; never add a VITE_ prefix or commit its value.

# Optional direct PostgreSQL adapter when the Supabase HTTP pair is absent.
# On Vercel, this requires the configured private GAME_DB_SCHEMA.
# DATABASE_URL=postgresql://<user>:<password>@<host>:<port>/<database>?sslmode=require
# GAME_DB_SCHEMA=game2048

CORS_ORIGINS=http://localhost:5173
# Production example: CORS_ORIGINS=https://2048.rafistacks.dev
