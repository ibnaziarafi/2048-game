# Local development uses GAME_DB_PATH if DATABASE_URL is unset.
GAME_DB_PATH=data/2048.sqlite3
# Vercel only: use the Supabase Connect dialog's transaction-pooler URL with TLS
# (sslmode=require), saved as a server-only encrypted Vercel environment secret.
# Pre-create this private schema; do not expose it through the Supabase Data API.
# DATABASE_URL=postgresql://postgres.lywyqgebmqdirkwvivus:<encoded-password>@<pooler-host>:6543/postgres?sslmode=require
# GAME_DB_SCHEMA=game2048
# Never use a VITE_ prefix for the database connection.
CORS_ORIGINS=http://localhost:5173
# Production CORS_ORIGINS=https://2048.rafistacks.dev
